# City Gate Capital — local development environment variables
# Copy to .env and fill in real values. Never commit .env (already gitignored).
# This list is kept in sync with render.yaml and src/server/lib/envValidator.ts —
# update all three together if you add/remove a config value.

# ── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3000

# ── Database (Neon Postgres) ───────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# ── Auth / sessions ─────────────────────────────────────────────────────────
SESSION_SECRET=replace-with-a-long-random-string
JWT_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=admin@citygate.capital
ADMIN_PASSWORD_HASH=generate-via-hashPassword()-in-adminCredentials.ts
ADMIN_UNLOCK_KEY=replace-with-a-long-random-string

# ── Card data encryption ────────────────────────────────────────────────────
# DO NOT rotate on an existing deploy without a data-migration plan —
# rotating this key makes existing encrypted card data unreadable.
CARD_ENCRYPTION_KEY=replace-with-a-long-random-string

# ── Email — Zoho Mail (primary) ─────────────────────────────────────────────
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNT_ID=
MAIL_PASSWORD=

# ── Email — Resend (secondary transport) ────────────────────────────────────
RESEND_API_KEY=
MAIL_FROM_ADDRESS=

# ── File storage — Cloudflare R2 ────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=cgc-media
R2_PUBLIC_URL=

# ── Market data providers (optional — trading features degrade gracefully) ──
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
POLYGON_API_KEY=
TWELVE_DATA_API_KEY=

# ── Live chat / support widget (optional) ───────────────────────────────────
SMARTSUPP_KEY=
SMARTSUPP_API_KEY=

# ── Analytics (optional) ────────────────────────────────────────────────────
GA_MEASUREMENT_ID=
GA_API_SECRET=
GTM_CONTAINER_ID=
GOOGLE_MAPS_API_KEY=

# ── Cloudflare DNS/zone management (optional) ───────────────────────────────
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# ── Registered but NOT wired to any route handler yet (AUDIT_REPORT.md §8) ──
# Leave unset until real integration work is done — setting these today does nothing.
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
