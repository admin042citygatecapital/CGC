{
  "name": "city-gate-capital",
  "version": "1.0.0",
  "private": true,
  "description": "City Gate Capital digital banking platform",
  "type": "module",
  "imports": {
    "#runtime/secrets": "./src/server/lib/runtimeSecrets.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/server/entry.ts && node scripts/copy-admin-docs.mjs",
    "build:vercel": "vite build && vite build --ssr src/server/entry.ts && node scripts/copy-admin-docs.mjs",
    "start": "node dist/server.bundle.mjs",
    "smoke": "node scripts/smoke-built-server.mjs",
    "production-guard": "node scripts/check-production-guard.mjs",
    "security:baseline": "tsx scripts/security-baseline.ts",
    "preview-claims": "node scripts/check-preview-claims.mjs",
    "release:check": "npm run preview-claims && npm run verify && npm run smoke && npm run e2e && npm run production-guard",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:ci": "vitest run --config vitest.server.config.mjs",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "verify:checks": "npm run type-check && npm run lint -- --quiet && npm run test:ci",
    "verify": "npm run verify:checks && npm run build",
    "verify:render": "node scripts/run-render-verify.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
    "clean": "rm -rf dist node_modules/.vite",
    "reset": "npm run clean && npm install",
    "db:migrate": "npx tsx src/server/db/migrate.ts",
    "db:schema": "npm run db:migrate",
    "db:import": "npx tsx src/server/db/importFlatFiles.ts",
    "db:import:dry": "npx tsx src/server/db/importFlatFiles.ts --dry-run",
    "db:validate": "npx tsx src/server/db/validateMigration.ts",
    "db:rollback": "npx tsx src/server/db/rollback.ts",
    "admin:rotate-password": "npx tsx scripts/rotate-super-admin-password.ts",
    "backup:operations": "npx tsx scripts/backup-operations.ts",
    "data:quarantine": "npx tsx scripts/quarantine-production-test-data.ts",
    "operations:quarantine": "npx tsx scripts/quarantine-operations-inbox.ts",
    "sponsor:evidence:drafts": "npx tsx scripts/prepare-sponsor-draft-evidence.ts",
    "receipt:preview": "npx tsx scripts/generate-transaction-receipt-preview.ts",
    "preview:seed": "npx tsx scripts/seed-preview-user.ts",
    "audit": "better-npm-audit audit --level high --registry=https://registry.npmjs.org --exclude 1124282"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.11",
    "@dr.pogodin/react-helmet": "^3.0.5",
    "@heroicons/react": "^2.2.0",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@supabase/server": "^1.6.0",
    "@supabase/supabase-js": "^2.111.0",
    "@tanstack/react-query": "^5.95.2",
    "ai": "^7.0.22",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "fflate": "^0.8.2",
    "hash-wasm": "^4.12.0",
    "jpeg-js": "^0.4.4",
    "lucide-react": "^0.454.0",
    "motion": "^12.29.2",
    "nodemailer": "9.1.1",
    "pdf-lib": "^1.17.1",
    "pngjs": "^7.0.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-resizable-panels": "^3.0.5",
    "react-router-dom": "7.18.2",
    "resend": "^6.17.2",
    "tailwind-merge": "^2.6.1",
    "ws": "^8.21.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@babel/core": "^7.29.0",
    "@babel/generator": "^7.29.1",
    "@babel/parser": "^7.29.3",
    "@babel/traverse": "^7.29.0",
    "@babel/types": "^7.29.0",
    "@eslint/js": "^9.16.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/babel__core": "^7.20.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.3",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.4.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "^4.1.10",
    "autoprefixer": "^10.4.27",
    "baseline-browser-mapping": "^2.10.0",
    "better-npm-audit": "^3.11.0",
    "eslint": "^9.16.0",
    "eslint-plugin-no-unsanitized": "^4.1.2",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "eslint-plugin-security": "^3.0.1",
    "globals": "14.0.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.20.6",
    "typescript": "^5.7.2",
    "vite": "^6.4.2",
    "vitest": "^4.1.10",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/ws": "^8.18.1"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "overrides": {
    "cmdk": "^1.1.1",
    "react-day-picker": "^9.9.0",
    "brace-expansion": "^2.0.1",
    "react-router": "7.18.2",
    "fast-uri": "3.1.7",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.18",
    "undici": "7.29.0",
    "tsx": {
      "esbuild": "0.28.1"
    },
    "browserslist": "4.28.9"
  }
}
