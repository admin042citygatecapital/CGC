{
  "name": "city-gate-capital",
  "version": "1.0.0",
  "private": true,
  "description": "City Gate Capital digital banking platform",
  "type": "module",
  "imports": {
    "#airo/secrets": "./export-plugins/airo-secrets.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/server/entry.ts",
    "build:vercel": "vite build && vite build --ssr src/server/entry.ts",
    "start": "node dist/server.bundle.mjs",
    "smoke": "node scripts/smoke-built-server.mjs",
    "production-guard": "node scripts/check-production-guard.mjs",
    "release:check": "npm run verify && npm run smoke && npm run production-guard",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:ci": "vitest run --config vitest.server.config.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "verify": "npm run type-check && npm run lint -- --quiet && npm run test:ci && npm run build",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
    "clean": "rm -rf dist node_modules/.vite",
    "reset": "npm run clean && npm install",
    "db:migrate": "npx tsx src/server/db/migrate.ts",
    "db:schema": "npm run db:migrate",
    "db:import": "npx tsx src/server/db/importFlatFiles.ts",
    "db:import:dry": "npx tsx src/server/db/importFlatFiles.ts --dry-run",
    "db:validate": "npx tsx src/server/db/validateMigration.ts",
    "db:rollback": "npx tsx src/server/db/rollback.ts",
    "preview:seed": "npx tsx scripts/seed-preview-user.ts",
    "audit": "better-npm-audit audit --level high --registry=https://registry.npmjs.org --exclude 1124282"
  },
