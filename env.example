# Application
VITE_APP_NAME=v8 App Template
VITE_PUBLIC_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000/api

# Server
NODE_ENV=development
PORT=3000

# Features
VITE_ENABLE_SOURCE_MAPPING=true
VITE_ENABLE_SSR=true

# Development Tools
VITE_SHOW_DEV_TOOLS=false
# Optional: same as app id — local Docker preview sets SITE_ID; with vite envPrefix SITE_, client can link to /develop/{id}
# SITE_ID=

# Database — Supabase Postgres
# Connection string from Supabase Dashboard → Project Settings → Database →
# Connection string → URI (use the "Transaction" pooler, port 6543).
# Aliases also accepted: SUPABASE_DB_URL, NEON_CONNECTION_STRING.
# When unset, the app falls back to local flat-file JSONL storage (dev only).
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase — server-side (Storage, Auth admin, Realtime broadcast from API routes)
# Project URL and keys from Supabase Dashboard → Project Settings → API.
# SUPABASE_URL=https://<project-ref>.supabase.co
# Accepts either naming generation — set ONE of each pair:
# SUPABASE_ANON_KEY=<anon-or-publishable-key>            # alias: SUPABASE_PUBLISHABLE_KEY
# SUPABASE_SERVICE_ROLE_KEY=<service-role-or-secret-key>  # alias: SUPABASE_SECRET_KEY — server-only, never expose to the client
# SUPABASE_STORAGE_BUCKET=cgc-media

# Supabase — client-side (browser bundle, src/lib/supabaseClient.ts)
# This is a Vite app: client-exposed vars use the VITE_ prefix (see
# envPrefix in vite.config.ts), not Next.js's NEXT_PUBLIC_ convention.
# These are the Vite equivalents of NEXT_PUBLIC_SUPABASE_URL /
# NEXT_PUBLIC_SUPABASE_ANON_KEY — same public, RLS-governed anon key.
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=<anon-or-publishable-key>

# Smartsupp live chat — public widget key, loaded client-side in production only
# SMARTSUPP_KEY=<smartsupp-widget-key>

# Google Search Console — site ownership verification
# Rendered server-side as <meta name="google-site-verification"> (src/server/entry.ts)
# GOOGLE_SITE_VERIFICATION=<verification-token>

# External APIs (when needed)
# OPENAI_API_KEY=your-key-here
# ANTHROPIC_API_KEY=your-key-here

# GoDaddy Commerce (when skill-installed)
# Set by commerce-related skills when storefront features are added
# VITE_GODADDY_CLIENT_ID=<uuid-from-task-config>
# VITE_GODADDY_API_HOST=<hostname-from-GODADDY_API_BASE_URL>
# GODADDY_API_BASE_URL=https://api.dev-godaddy.com

# Authentication (when needed)
# JWT_SECRET=your-secret-here
# SESSION_SECRET=your-secret-here
