# City Gate Capital — local and production configuration

# Runtime
NODE_ENV=development
PLATFORM_MODE=preview
VITE_PLATFORM_MODE=preview
PUBLIC_SITE_PUBLISHED=0
VITE_PUBLIC_SITE_PUBLISHED=0
VITE_LAUNCH_APPROVED=0
ENABLE_FINANCIAL_OPERATIONS=0
ENABLE_PAPER_TRADING=0
ALLOW_PUBLIC_REGISTRATION=1
VITE_ALLOW_PUBLIC_REGISTRATION=1
# Live launch attestations. These values cannot unlock financial operations by
# themselves. A reviewed provider-adapter implementation and launch approval
# are also required in code before the public disclosure can be removed.
LIVE_COMPLIANCE_APPROVAL_ID=
TARGET_LAUNCH_JURISDICTION=
LEGAL_ENTITY_REGISTRATION=
REGULATORY_COUNSEL_APPROVAL_ID=
SPONSOR_FINANCIAL_INSTITUTION=
PROGRAM_PROVIDER=
PROVIDER_CONTRACTS_APPROVAL_ID=
KYC_PROVIDER=
AML_SCREENING_PROVIDER=
SANCTIONS_SCREENING_PROVIDER=
TRANSACTION_MONITORING_PROVIDER=
LEDGER_PROVIDER=
RECONCILIATION_CONTROL_ID=
PAYMENT_PROVIDER=
CARD_ISSUER_PROCESSOR=
CUSTODY_PROVIDER=
COMPLIANCE_OFFICER=
CUSTOMER_DISCLOSURE_APPROVAL_ID=
SECURITY_PENTEST_REPORT_ID=
INCIDENT_RESPONSE_APPROVAL_ID=
DATA_RETENTION_APPROVAL_ID=
ENABLE_TRANSACTION_MONITORING=0
ENABLE_SIGNED_PROVIDER_WEBHOOKS=0
ENABLE_DAILY_RECONCILIATION=0
ENABLE_MAKER_CHECKER=0
ENABLE_SANCTIONS_RESCREENING=0

# Comma-separated provider codes approved through sponsor due diligence. Each
# code requires a 32+ character HMAC webhook secret using the normalized suffix.
# Example code verified-id -> ONBOARDING_PROVIDER_WEBHOOK_SECRET_VERIFIED_ID.
APPROVED_ONBOARDING_PROVIDERS=
APPROVED_ENTITY_REGISTRY_HOSTS=find-and-update.company-information.service.gov.uk
ONBOARDING_PROVIDER_WEBHOOK_SECRET_VERIFIED_ID=
HOST=0.0.0.0
PORT=5173
APP_URL=http://127.0.0.1:5173
PUBLIC_URL=http://127.0.0.1:5173
VITE_APP_NAME=City Gate Capital
VITE_PUBLIC_URL=http://127.0.0.1:5173

# Required in production
# Standard PostgreSQL connection string (managed pooler URL recommended)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DATABASE_POOL_SIZE=10
# Supabase project API configuration. The service-role key is server-only and
# must never use a VITE_ prefix or be returned by an API response.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Newer Supabase key aliases are also supported:
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=cgc-media
PRIVATE_DATA_ROOT=/private
ENABLE_LOCAL_OPERATIONAL_BACKUPS=1
BACKUP_DIRECTORY=/private/backups
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_HOURS=24
# Set only after confirming provider-managed database backups and completing a restore test.
MANAGED_DATABASE_BACKUPS_CONFIRMED=0
BACKUP_LAST_RESTORE_TEST_AT=
# Destructive changes remain disallowed. The quarantine command is reversible,
# defaults to dry-run, and additionally requires an exact reserved-domain email
# list, a recently verified provider backup, and a matching SHA-256 confirmation.
QUARANTINE_USER_EMAILS=
QUARANTINE_CONFIRM_SHA256=
QUARANTINE_EXPECTED_CUSTOMERS=
QUARANTINE_EXPECTED_TRANSACTIONS=
PROVIDER_BACKUP_REFERENCE=
PROVIDER_BACKUP_VERIFIED_AT=
QUARANTINE_REASON=
QUARANTINE_ACTOR=
RESTORE_APPROVAL_REFERENCE=
MEDIA_ASSET_ROOT=/shared-storage/public/assets
# Generate each secret independently with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-64-random-hex-characters
CARD_ENCRYPTION_KEY=replace-with-64-random-hex-characters
# Generate with: node -e "require('bcryptjs').hash('replace-me',12).then(console.log)"
ADMIN_PASSWORD_HASH=replace-with-an-argon2-or-bcrypt-password-hash
ADMIN_EMAIL=admin@citygate.capital
# Independent sponsor-package checker. Store only the SHA-256 hash of the
# reviewer key; this credential cannot create an administration session.
SPONSOR_REVIEWER_EMAIL=
# Store only the SHA-256 digest. Never place the raw reviewer credential here.
SPONSOR_REVIEWER_KEY_HASH=

# Session policy
SESSION_TIMEOUT_MINUTES=60
SESSION_MAX_HOURS=8
SESSION_CUSTOMER_TIMEOUT_MINUTES=60
SESSION_CUSTOMER_MAX_HOURS=8

# Email delivery (Resend is the production transport; Zoho hosts the inboxes)
MAIL_FROM_NAME=City Gate Capital
MAIL_FROM_ADDRESS=info@citygate.capital
RESEND_API_KEY=
RESEND_WEBHOOK_SIGNING_SECRET=

# Email branding defaults (admin changes in Email Center are stored in PostgreSQL)
EMAIL_BRAND_NAME=City Gate Capital
EMAIL_LOGO_URL=https://citygate.capital/assets/brand/city-gate-capital-horizontal.png
EMAIL_WEBSITE_URL=https://citygate.capital
EMAIL_WEBSITE_BUTTON_LABEL=Open City Gate Capital
EMAIL_SUPPORT_ADDRESS=support@citygate.capital
EMAIL_NOREPLY_ADDRESS=noreply@citygate.capital
EMAIL_SECURITY_ADDRESS=security@citygate.capital
EMAIL_COMPLIANCE_ADDRESS=compliance@citygate.capital
EMAIL_ADMIN_ADDRESS=admin@citygate.capital
EMAIL_INFO_ADDRESS=info@citygate.capital
COMPLAINT_RESPONSE_TARGET_DAYS=15
EMAIL_SUPPORT_PHONE=+44 7888 382458
EMAIL_POSTAL_ADDRESS=Business address pending verification
EMAIL_PRIMARY_COLOR="#C9A84C"
EMAIL_FOOTER_MESSAGE=Secure access to your City Gate Capital account and services.

# Optional legacy Zoho OAuth / SMTP fallback
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNT_ID=
MAIL_HOST=smtp.zoho.com
MAIL_PORT=465
MAIL_USERNAME=info@citygate.capital
MAIL_PASSWORD=

# Optional integrations
# Public Tawk.to embed identifiers (not secrets)
VITE_TAWK_PROPERTY_ID=6a773b21198d971d45c5ff66
VITE_TAWK_WIDGET_ID=1jvgrtvnn
SMARTSUPP_KEY=
SMARTSUPP_API_KEY=
GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=
BINANCE_API_KEY=
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
TWELVE_DATA_API_KEY=
POLYGON_API_KEY=

# Plaid account-linking (sandbox only until production approval/provider sign-off)
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_TOKEN_ENCRYPTION_KEY=
PLAID_REDIRECT_URI=https://citygate.capital/plaid/oauth

# Development only — never enable in production
ENABLE_LOCAL_DEMO_USER=0
ENABLE_PREVIEW_USER_SEED=0
PREVIEW_USER_EMAIL=
PREVIEW_USER_PASSWORD=
PREVIEW_USER_NAME=City Gate Preview
VITE_SHOW_DEV_TOOLS=false
